[Desktop Entry]
Type=Application
Name=VectorCraft
GenericName=Vector Graphics Editor
Comment=Draw and edit vector illustrations, SVG and PDF
Exec=vectorcraft %F
TryExec=vectorcraft
Icon=io.github.treeforjs.vectorcraft
Terminal=false
StartupNotify=true
StartupWMClass=io.github.treeforjs.vectorcraft
Categories=Graphics;2DGraphics;VectorGraphics;
Keywords=vector;illustration;svg;pdf;drawing;bezier;
MimeType=application/x-vectorcraft;image/svg+xml;image/svg+xml-compressed;application/pdf;
